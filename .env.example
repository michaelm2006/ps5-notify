# Required: Discord webhook URL (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Optional: Mention prepended ONLY to restock alerts (not startup or error alerts)
# Examples: @everyone, @here, <@123456789012345678>, <@&987654321098765432>
DISCORD_MENTION=

# Comma-separated list of enabled retailer adapters (default: playstation_uk)
ENABLED_RETAILERS=playstation_uk

# Target product URLs (override if Sony changes URL or you want to watch another SKU)
PLAYSTATION_UK_URL=https://www.playstation.com/en-gb/ps5/ps5-pro/buy-now/

# Fetcher backend for PlayStation UK (http is lightweight and recommended)
PLAYSTATION_UK_FETCHER=http
# Optional global override (leave blank to use per-retailer defaults):
# FETCHER_BACKEND=

# Polling cadence (seconds)
POLL_INTERVAL_SECONDS=30
POLL_JITTER_SECONDS=5

# Minimum seconds between restock notifications for the same retailer (flicker protection)
RESTOCK_COOLDOWN_SECONDS=300

# Consecutive errors/blocks before sending a single quiet Discord error alert
ERROR_ALERT_THRESHOLD=5

# Per-retailer exponential backoff bounds (seconds)
BACKOFF_BASE_SECONDS=60
BACKOFF_MAX_SECONDS=1800

# HTTP request timeout (seconds)
HTTP_TIMEOUT_SECONDS=15

# Path to persistent JSON state file
STATE_FILE_PATH=data/state.json

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
